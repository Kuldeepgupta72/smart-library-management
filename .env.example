# Copy to .env and fill in real values. .env is gitignored — never commit it.

# GitHub MCP server (project-level, .mcp.json "github")
GITHUB_TOKEN=

# Jira MCP server (project-level, .mcp.json "jira")
JIRA_URL=
JIRA_EMAIL=
JIRA_API_TOKEN=

# Confluence MCP server (project-level, .mcp.json "confluence")
CONFLUENCE_URL=
CONFLUENCE_EMAIL=
CONFLUENCE_API_TOKEN=
